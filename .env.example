# Swachta Environment Variables Template
# Copy this file to .env and fill in real values

# ─── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://swachta:swachta@localhost:5432/swachta

# ─── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-minimum-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ─── OTP (SMS) — Twilio or MSG91 ───────────────────────────────────────────────
# For MVP: OTP_PROVIDER=mock will log OTPs to console instead of sending SMS
OTP_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ─── Photo Storage ─────────────────────────────────────────────────────────────
# Use 'cloudinary' or 's3'
PHOTO_STORAGE=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── App Config ────────────────────────────────────────────────────────────────
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173","exp://localhost:8081"]
